; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Vaelthorn"
config/description="Turn-based pixel-art RPG with party combat, hero collection, gacha, async PvP arena, guilds, and co-op boss raids."
run/main_scene="res://scenes/title/title.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Game="*res://scripts/runtime/game.gd"
EventBus="*res://scripts/runtime/event_bus.gd"
ContentRegistry="*res://scripts/runtime/content_registry.gd"
SaveManager="*res://scripts/runtime/save_manager.gd"
SoundManager="*res://scripts/runtime/sound_manager.gd"
Telemetry="*res://scripts/runtime/telemetry.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="viewport"

[gui]

theme/default_font_antialiasing=0

[rendering]

textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
